{
  "name": "@deckflow/deckprobe",
  "version": "2.3.1",
  "description": "CLI and browser SDK for probing PDF, Microsoft Office, and Apple iWork documents with DeckProbe",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deckflow/deckprobe.git",
    "directory": "packages/deckprobe-js"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./wasm": "./wasm/deckprobe_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "bin": {
    "deckprobe": "./bin/deckprobe.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "wasm",
    "README.md"
  ],
  "sideEffects": [
    "./dist/worker-runtime.js",
    "./dist/index.node.js"
  ],
  "scripts": {
    "clean": "rm -rf dist wasm/deckprobe_wasm.js wasm/deckprobe_wasm_bg.wasm wasm/package.json",
    "build:wasm": "wasm-pack build ../../crates/deckprobe-wasm --target web --release --out-dir ../../packages/deckprobe-js/wasm --out-name deckprobe_wasm --no-pack --no-opt && rm -f ../../packages/deckprobe-js/wasm/.gitignore",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:version": "node ./scripts/check-version.mjs",
    "check:wasm": "node ./scripts/check-wasm.mjs",
    "check:pack": "node ./scripts/check-pack.mjs",
    "test": "npm run check && npm run check:version && npm run check:wasm && npm run check:pack && npm run test:iwork && npm run test:browser && npm run test:vite && npm run test:node && npm run test:cli",
    "test:public": "npm run check && npm run check:version && npm run check:wasm && npm run check:pack && npm run test:iwork && npm run test:browser && npm run test:vite",
    "test:iwork": "node ./scripts/iwork-smoke.mjs",
    "test:browser": "node ./scripts/browser-smoke.mjs",
    "test:vite": "node ./scripts/vite-smoke.mjs",
    "test:node": "node ./scripts/node-smoke.mjs",
    "test:cli": "node ./scripts/cli-smoke.mjs",
    "build:platforms": "node ./scripts/build-platform-packages.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "optionalDependencies": {
    "@deckflow/deckprobe-darwin-arm64": "2.3.1",
    "@deckflow/deckprobe-darwin-x64": "2.3.1",
    "@deckflow/deckprobe-linux-arm64-gnu": "2.3.1",
    "@deckflow/deckprobe-linux-arm64-musl": "2.3.1",
    "@deckflow/deckprobe-linux-x64-gnu": "2.3.1",
    "@deckflow/deckprobe-linux-x64-musl": "2.3.1",
    "@deckflow/deckprobe-win32-x64-msvc": "2.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "wasm-pack": "0.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
